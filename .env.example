# Local MVP defaults. Productionda barcha secretlarni server secret manager orqali bering.
ENVIRONMENT=development
MOLIYA_BIND_HOST=127.0.0.1
MOLIYA_BIND_PORT=8088
MOLIYA_INTERNAL_TOKEN=dev-only-change-me
MOLIYA_ALLOWED_ACTORS=hermes,local-dev

# rule = API kalitisiz lokal test; openai = real AI parsing
MOLIYA_PARSER_MODE=rule
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

MOLIYA_DB_PATH=./data/moliya.db

# memory = lokal test; google = real Google Sheets
MOLIYA_SHEET_MODE=memory
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# JSON secretni bitta qatorda berish mumkin:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Hermes skill client
MOLIYA_AGENT_URL=http://127.0.0.1:8088
